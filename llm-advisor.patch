+    PotionsBossHandler(),
+    PotionsEventFightHandler(),
+    PotionsEliteHandler(),
+]
+
+LLM_IRONCLAD: AiStrategy = AiStrategy(
+    name='LLM_IRONCLAD',
+    character=Character.IRONCLAD,
+    handlers=llm_potion_handlers + [
+        CommonAstrolabeHandler(CARD_REMOVAL_PRIORITY_LIST),
+        CommonBattleHandler(),
+        CommonBossRelicHandler(),
